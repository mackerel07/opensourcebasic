# 환경 변수 자리 (값은 비워 둡니다)
#
# 아직 실제 연결 전입니다. 지금 코드는 아래 값을 읽지 않습니다.
# 소유자 사전 검토(docs/REVIEW_GATE.md) 승인 후 연결 작업에서 사용합니다.
#
# 로컬: 이 파일을 .env.local로 복사해 값을 채웁니다. (.env.local은 커밋되지 않습니다)
# Vercel: Project → Settings → Environment Variables에 같은 이름으로 넣고 다시 배포합니다.

# Supabase 프로젝트 주소 (예: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase 공개용 키(anon / publishable key)만 넣습니다.
# service_role 같은 비밀키는 절대 넣지 않습니다. NEXT_PUBLIC_ 값은 브라우저에 그대로 공개됩니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 모델 서버 HTTPS 주소 (예: https://model.example.com)
# 서버에서만 쓰도록 NEXT_PUBLIC_을 붙이지 않았습니다. 브라우저에서 직접 부를지는 검토 때 정합니다.
MODEL_API_URL=
